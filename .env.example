# Optional. The production server defaults to local-only access.
HOST=127.0.0.1

# Optional. Render supplies PORT automatically; local API default is 4173.
PORT=4173

# Optional. Required only for automated SEC EDGAR retrieval.
# Format: Application Name contact@example.org
SEC_USER_AGENT=

# Optional. Leave blank to use Playwright-managed Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Optional. Set to 1 to skip rendered crawling and use plain-fetch fallback.
DISABLE_RENDERED_CRAWLING=0
