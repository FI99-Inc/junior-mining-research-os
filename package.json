{
  "name": "junior-mining-research-os",
  "private": true,
  "version": "0.1.0",
  "description": "Evidence-driven research workbench for Canadian and U.S. junior mining companies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FI99-Inc/junior-mining-research-os.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx watch server/index.ts",
    "server:demo": "tsx watch server/index.ts --demo",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "audit:freshness": "tsx scripts/audit-market-freshness.mts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "vite": "^7.3.6",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
